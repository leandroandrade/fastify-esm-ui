{
  "name": "fastify-esm-ui",
  "version": "1.2.0",
  "private": true,
  "description": "Template Fastify (ESM) com interface web: EJS, TailwindCSS e Alpine.js (build CSP)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "test": "node --env-file=.env.test --test --test-concurrency=1 './tests/**/*.test.js'",
    "test:firefox": "node --env-file=.env.test --env-file=.env.test.firefox --test --test-concurrency=1 './tests/business/e2e/**/*.test.js'",
    "test:only": "node --env-file=.env.test --test --test-only './tests/**/*.test.js'",
    "test:single": "node --env-file=.env.test --test --test-concurrency=1",
    "test:cov": "c8 --reporter=text node --env-file=.env.test --test --test-concurrency=1 --test-reporter=dot './tests/**/*.test.js'",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --env-file=.env.test --test --test-concurrency=1 './tests/**/*.test.js'",
    "test:report": "c8 --reporter=html node --env-file=.env.test --test --test-concurrency=1 --test-reporter=dot './tests/**/*.test.js'",
    "test:ci": "node --env-file=.env.test --test --test-concurrency=1 --test-reporter=dot './tests/**/*.test.js'",
    "dev": "npm run build && node --env-file=.env --watch-path=./src src/server.js",
    "start": "node src/server.js",
    "lint": "eslint",
    "lint:fix": "npm run lint -- --fix",
    "css:build": "tailwindcss -i ./templates/css/custom.css -o ./public/css/styles.css --minify",
    "js:build": "mkdir -p public/js && cp node_modules/@alpinejs/csp/dist/cdn.min.js public/js/alpine.min.js",
    "build": "npm run css:build && npm run js:build",
    "e2e:setup": "playwright install chromium firefox"
  },
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandroandrade/fastify-esm-ui.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leandroandrade/fastify-esm-ui/issues"
  },
  "homepage": "https://github.com/leandroandrade/fastify-esm-ui#readme",
  "dependencies": {
    "@fastify/autoload": "^6.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/env": "^7.0.1",
    "@fastify/error": "^4.2.1",
    "@fastify/formbody": "^9.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.8",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/view": "^12.0.1",
    "close-with-grace": "^2.5.0",
    "ejs": "^7.0.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@tailwindcss/cli": "^4.3.5",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "neostandard": "^0.14.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5"
  }
}
