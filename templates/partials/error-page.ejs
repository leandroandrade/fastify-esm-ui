<%#
  Standalone error page (no layout: it must render even when the layout is what failed).
  Locals: status, heading, message, pageTitle.
%><!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('head.ejs') %>
  <meta name="robots" content="noindex, nofollow">

  <title><%= siteName %> | <%= pageTitle %></title>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-900">
  <main class="flex-1 flex flex-col items-center justify-center px-6 py-12">
    <a href="/" class="mb-8" aria-label="Ir para a página inicial">
      <%- include('logo.ejs', { logoClass: 'h-12 w-12' }) %>
    </a>

    <h1 class="text-8xl lg:text-9xl font-bold text-primary mb-6"><%= status %></h1>

    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
      <%= heading %>
    </h2>

    <p class="text-lg text-gray-600 dark:text-gray-400 mb-10 max-w-2xl text-center">
      <%= message %>
    </p>

    <a href="/"
       class="btn-primary px-8 py-3.5 text-base shadow-lg hover:shadow-xl">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12l-2 0l9 -9l9 9l-2 0"/>
        <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"/>
        <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"/>
      </svg>
      Ir para a página inicial
    </a>
  </main>

  <footer class="py-6 text-center">
    <p class="text-sm text-gray-500 dark:text-gray-500">
      <%= siteName %> © <%= new Date().getFullYear() %> - REST API Template
    </p>
  </footer>

<script src="/public/js/alpine.min.js" defer></script>
</body>
</html>
