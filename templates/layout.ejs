<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head.ejs') %>

  <meta name="robots" content="index, follow">
  <meta name="description" content="<%= description %>">
  <meta name="author" content="<%= siteName %>">

  <link rel="canonical" href="<%= publicUrl %><%= canonicalPath %>">

  <title><%= title %></title>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= publicUrl %><%= canonicalPath %>">
  <meta property="og:image" content="<%= publicUrl %><%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= title %>">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= publicUrl %><%= ogImage %>">

  <script type="application/ld+json"><%- structuredData %></script>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100" x-data="main()">
<a href="#conteudo" class="skip-link">Pular para o conteúdo</a>

<main class="flex-1 flex flex-col">
  <article class="flex-1">
    <nav class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50 shadow-sm" x-data="{ mobileMenuOpen: false }" aria-label="Navegação principal">
      <div class="container mx-auto px-6">
        <div class="flex items-center justify-between h-16">
          <!-- Logo section -->
          <div class="flex items-center gap-2">
            <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
              <%- include('partials/logo.ejs', { logoClass: 'h-7 w-7' }) %>
              <strong class="text-lg font-bold text-gray-900 dark:text-white"><%= siteName %></strong>
            </a>
          </div>

          <!-- Desktop Navigation -->
          <div class="hidden lg:flex items-center justify-between flex-1 ml-10">
            <div class="flex items-center gap-1">
              <a href="/"
                 <% if (currentPage === 'home') { %>aria-current="page"<% } %>
                 class="nav-link">
                Home
              </a>
              <% if (docsEnabled) { %>
              <a href="/docs"
                 class="nav-link">
                API Docs
              </a>
              <% } %>
            </div>

            <div class="flex items-center">
              <a href="https://github.com/leandroandrade/fastify-esm-ui"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="nav-link flex items-center gap-2">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                </svg>
                GitHub
              </a>
            </div>
          </div>

          <!-- Right-side controls -->
          <div class="flex items-center gap-1 lg:ml-2">
            <!-- Theme toggle: sun in dark mode (click → light), moon in light mode (click → dark) -->
            <button type="button"
                    id="theme-toggle"
                    @click="$store.theme.toggle()"
                    class="btn-icon text-gray-700 dark:text-gray-300"
                    :aria-label="$store.theme.label"
                    :title="$store.theme.label">
              <svg x-show="$store.theme.isDark" x-cloak class="w-5 h-5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/>
              </svg>
              <svg x-show="!$store.theme.isDark" x-cloak class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/>
              </svg>
            </button>

            <!-- Mobile menu button -->
            <button type="button"
                    @click="mobileMenuOpen = !mobileMenuOpen"
                    :aria-expanded="mobileMenuOpen"
                    aria-controls="mobile-menu"
                    aria-label="Abrir menu"
                    class="lg:hidden p-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
              <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
              <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" x-cloak aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu"
             x-show="mobileMenuOpen"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-1"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 -translate-y-1"
             @click.away="mobileMenuOpen = false"
             x-cloak
             class="lg:hidden py-4 border-t border-gray-200 dark:border-gray-700">
          <div class="space-y-1">
            <a href="/"
               <% if (currentPage === 'home') { %>aria-current="page"<% } %>
               @click="mobileMenuOpen = false"
               class="nav-link block">
              Home
            </a>
            <% if (docsEnabled) { %>
            <a href="/docs"
               @click="mobileMenuOpen = false"
               class="nav-link block">
              API Docs
            </a>
            <% } %>
            <a href="https://github.com/leandroandrade/fastify-esm-ui"
               target="_blank"
               rel="noopener noreferrer"
               class="nav-link block">
              GitHub
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Dynamic notifications stack (Alpine.js controlled) -->
    <div id="notification-alert"
         x-data="notifications"
         @show-notification.window="add($event)"
         x-show="hasNotifications"
         x-cloak
         class="fixed bottom-0 right-0 flex w-full max-w-sm flex-col space-y-4 pr-4 pb-4 sm:justify-start z-50"
         role="status"
         aria-live="polite">
      <template x-for="notification in notifications" :key="notification.id">
        <div
            x-data="notification"
            x-show="show"
            x-transition.duration.500ms
            class="pointer-events-auto relative w-full max-w-sm rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-2 shadow-lg">
          <div class="flex items-start gap-4">
            <div class="flex-1 py-1.5 pl-2.5 flex gap-2">
              <!-- Icons -->
              <div x-show="notification.type === 'info'" class="flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="mt-0.5 size-4 text-blue-600" aria-hidden="true">
                  <path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z" clip-rule="evenodd" />
                </svg>
                <span class="sr-only">Information:</span>
              </div>

              <div x-show="notification.type === 'success'" class="flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="mt-0.5 size-4 text-green-600" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm3.844-8.791a.75.75 0 0 0-1.188-.918l-3.7 4.79-1.649-1.833a.75.75 0 1 0-1.114 1.004l2.25 2.5a.75.75 0 0 0 1.15-.043l4.25-5.5Z" clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Success:</span>
              </div>

              <div x-show="notification.type === 'danger'" class="flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="mt-0.5 size-4 text-red-600" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Error:</span>
              </div>

              <div x-show="notification.type === 'warning'" class="flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="mt-0.5 size-4 text-amber-600" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8.485 2.495c-.673-1.167-2.296-1.167-2.97 0L.97 10.495c-.673 1.167.156 2.625 1.485 2.625h11.09c1.328 0 2.158-1.458 1.485-2.625L8.485 2.495ZM8 5.25a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0V6A.75.75 0 0 1 8 5.25Zm0 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Warning:</span>
              </div>

              <!-- Text -->
              <div class="flex flex-col gap-y-2">
                <p x-text="title" class="capitalize font-medium text-sm text-gray-800 dark:text-gray-100"></p>
                <div class="text-sm text-gray-600 dark:text-gray-400" x-text="notification.content"></div>
              </div>
            </div>
            <!-- Remove button -->
            <div class="flex items-center">
              <button @click="transitionOut()" type="button" class="inline-flex items-center font-medium justify-center p-1.5 rounded-md hover:bg-gray-800/5 dark:hover:bg-gray-100/5 text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
                <svg aria-hidden="true" class="size-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Close notification</span>
              </button>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- Server-side messages go through the same toast stack. -->
    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div x-data="flashMessage" data-type="danger" data-message="<%= errorMsg %>" hidden></div>
    <% } %>

    <div id="conteudo" tabindex="-1">
      <%- body %>
    </div>
  </article>

  <footer class="mt-auto border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 py-6">
    <div class="container mx-auto px-6">
      <p class="text-sm text-center text-gray-600 dark:text-gray-400">
        Fastify ESM UI © <%= new Date().getFullYear() %> - UI Template
      </p>
      <p class="mt-1 text-xs text-center text-gray-500 dark:text-gray-500">
        build <span class="font-mono"><%= commitSha %></span>
      </p>
    </div>
  </footer>
</main>

<script src="/public/js/main.js" defer></script>
<% scripts.forEach(function (script) { %>
<script src="/public/js/<%= script %>" defer></script>
<% }); %>
<script src="/public/js/alpine.min.js" defer></script>
</body>
</html>
