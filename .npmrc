# Supply-chain hardening. A compromised package is usually caught and unpublished within
# days, so a version younger than this is not installed yet.
min-release-age=7

# Install scripts are the usual vector of a malicious package: none run on `npm install`.
# A dependency that genuinely needs one is approved explicitly (`npm approve-scripts`).
# Playwright browsers come from `npm run e2e:setup`, not from a postinstall.
ignore-scripts=true
