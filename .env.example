# Server
PORT=3000
HOST=0.0.0.0

# Defaults to info when unset, so a deployment that forgets it does not log at debug.
LOG_LEVEL=debug

# Cross-site origins allowed to send unsafe methods (comma-separated). Empty by default:
# production trusts none unless it is set explicitly.
TRUSTED_ORIGINS=http://localhost:3000

# Origin the site is served from. Canonical links, Open Graph tags, robots.txt and
# sitemap.xml are all built from it, so production must set it (e.g. https://example.com).
PUBLIC_URL=http://localhost:3000

# Addresses/CIDRs of the proxy to trust, comma-separated. Who to trust belongs to the
# deployment: in production declare the range of the load balancer/edge in front of the
# container. A `npm start` or docker-compose publish the port directly and must leave this
# empty — the rate limiter keys on req.ip, and trusting a proxy that is not there lets a
# client rotate X-Forwarded-For and escape the limit. Absent or empty = header ignored.
#
# A hop count does not work: Fastify 5.12.1 ignores a numeric trustProxy because it cannot
# validate the immediate peer. A number here raises an error at boot.
TRUSTED_PROXY_IPS=

# Discovery mode: logs the peer of every connection, to find out which address the edge
# uses and only then fill in TRUSTED_PROXY_IPS. Turn it on, hit the app a few times, read
# the log and turn it off. Regardless of it, an X-Forwarded-For arriving from a peer outside
# the list always raises a warning (once per process).
TRUSTED_PROXY_DEBUG=false

# Swagger UI at /docs. Off by default (an unset variable in production means no API map
# published); on here for local development.
DOCS_ENABLED=true

# Commit of the running build, shown in the footer. The Docker image receives it as a build
# argument; set it by hand only to reproduce a deployed footer locally.
GIT_COMMIT_HASH=dev
